<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex">
  <%- include('../partials/sidebar') %>
  
  <main class="flex-1 p-6">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Tags</h1>
        <p class="text-gray-500">Manage all tags</p>
      </div>
      <a href="/admin/tags/create" class="bg-green-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-green-700 transition-colors">
        <i class="fas fa-plus mr-2"></i>New Tag
      </a>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4">
        <i class="fas fa-check-circle mr-2"></i><%= success %>
      </div>
    <% } %>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">ID</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Name</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Posts Count</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% if (tags.length === 0) { %>
              <tr>
                <td colspan="4" class="px-6 py-12 text-center text-gray-500">
                  <i class="fas fa-tags text-4xl text-gray-300 mb-3 block"></i>
                  No tags found.
                </td>
              </tr>
            <% } else { %>
              <% tags.forEach(tag => { %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 text-sm text-gray-500"><%= tag.id %></td>
                  <td class="px-6 py-4">
                    <span class="px-3 py-1 bg-green-50 text-green-700 rounded-full border border-green-200 font-medium"><%= tag.name %></span>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-600"><%= tag._count.posts %> posts</td>
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-2">
                      <a href="/admin/tags/<%= tag.id %>/edit" class="text-gray-400 hover:text-green-600" title="Edit">
                        <i class="fas fa-edit"></i>
                      </a>
                      <form action="/admin/tags/<%= tag.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure?')">
                        <button type="submit" class="text-gray-400 hover:text-red-600" title="Delete">
                          <i class="fas fa-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
